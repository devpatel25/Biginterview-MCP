# Copy to .env. No passwords or tokens belong here — auth is a manual headed login (PLAN.md §6).

# Big Interview portal
BASE_URL=https://neu.biginterview.com

# Local data root: ledger, feedback backups, snapshots (created 0700, PLAN.md §14)
DATA_DIR=~/.resumeai-mcp
# Persistent Chromium profile = session cookies = login material. Keep outside the repo. (0700)
PROFILE_DIR=~/.resumeai-mcp/resumeai-profile

# Browser
HEADLESS=true
# "chrome" = real Chrome channel (PLAN.md §6.3); empty = bundled Chromium
BROWSER_CHANNEL=chrome
NAV_TIMEOUT_MS=30000

# Human-like pacing between UI actions, seconds (PLAN.md §12)
HUMAN_DELAY_MIN_S=2
HUMAN_DELAY_MAX_S=5
